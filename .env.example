# Copy to .env. Everything is optional except (strongly recommended) the password.
# Values set here are re-applied on every start and override what was saved in the UI.

# --- Manager ---
# Admin password for the web UI. If unset, one is generated and printed in the log on first run.
VSM_ADMIN_PASSWORD=
# Optional bearer token for scripting the REST API (Authorization: Bearer <token>).
#VSM_API_TOKEN=
#VSM_WEB_PORT=8810
#TZ=America/New_York
# Match the owner of a bind-mounted data folder on Linux hosts.
#PUID=1000
#PGID=1000
# Set to true when the UI is only reachable over HTTPS (reverse proxy).
#VSM_SECURE_COOKIES=false
# Proxies allowed to set X-Forwarded-* headers (comma-separated IPs, or * inside a private Docker network).
#VSM_TRUSTED_PROXIES=127.0.0.1

# --- Unattended install ---
# Download SteamCMD and the server on first start, then launch it.
#VSM_AUTO_INSTALL=true
#VSM_AUTO_START=true
#VSM_UPDATE_ON_START=false
#VSM_STEAM_BRANCH=public

# --- Server ---
#VSM_SERVER_NAME=My Vein Server
#VSM_SERVER_DESCRIPTION=
#VSM_SERVER_PASSWORD=
#VSM_MAX_PLAYERS=16
#VSM_GAME_PORT=7777
#VSM_QUERY_PORT=27015
# Comma-separated 17-digit SteamID64s.
#VSM_SUPER_ADMINS=
#VSM_ADMINS=
#VSM_EXTRA_ARGS=

# --- Discord ---
#VSM_DISCORD_WEBHOOK_URL=
